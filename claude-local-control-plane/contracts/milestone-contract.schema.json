{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lcac/milestone-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "milestoneId",
    "objective",
    "approvedBy",
    "approvedAt",
    "approvedCapabilities",
    "authorizedPathEnvelope",
    "prohibitedPaths",
    "allowedChecks",
    "roadmapRefs",
    "architectureRefs"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "milestoneId": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "format": "date-time"},
    "approvedCapabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authorizedPathEnvelope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "prohibitedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "allowedChecks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "roadmapRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "architectureRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
