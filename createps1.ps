& {
    $ErrorActionPreference = 'Stop'

    $hf1Root = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1'
    $hf1ExpectedHead = 'b2e44c3a1a051aa7fa6008831d225bc06d22e847'
    $hf1ExpectedBranch = 'hotfix/hf1-oracle-fresh-consumer'
    $hf1Vsce = Join-Path $hf1Root 'node_modules\.bin\vsce.cmd'

    Set-Location -LiteralPath $hf1Root

    if ((git rev-parse HEAD).Trim() -ne $hf1ExpectedHead) {
        throw 'Unexpected HF1 HEAD.'
    }

    if ((git branch --show-current).Trim() -ne $hf1ExpectedBranch) {
        throw 'Unexpected HF1 branch.'
    }

    git diff --cached --quiet
    if ($LASTEXITCODE -ne 0) {
        throw 'Staged changes detected.'
    }

    $hf1BeforeStatus = @(
        git status --porcelain=v1 --untracked-files=all
    )

    if ($hf1BeforeStatus.Count -ne 27) {
        throw "Expected exactly 27 HF1 changed files; observed $($hf1BeforeStatus.Count)."
    }

    git diff --check
    if ($LASTEXITCODE -ne 0) {
        throw 'git diff --check failed.'
    }

    if (-not (Test-Path -LiteralPath $hf1Vsce -PathType Leaf)) {
        throw 'Local vsce.cmd is unavailable. Do not use npx or download dependencies.'
    }

    $hf1PackageDirectory = Join-Path `
        $env:TEMP `
        ('HF1_TEST_PACKAGE_' + (Get-Date -Format 'yyyyMMdd_HHmmss'))

    New-Item `
        -ItemType Directory `
        -Path $hf1PackageDirectory `
        -ErrorAction Stop | Out-Null

    $hf1Vsix = Join-Path `
        $hf1PackageDirectory `
        'databricks-etl-copilot-hf1-test.vsix'

    $hf1Stdout = Join-Path $hf1PackageDirectory 'vsce.stdout.log'
    $hf1Stderr = Join-Path $hf1PackageDirectory 'vsce.stderr.log'

    $hf1PackageProcess = Start-Process `
        -FilePath $hf1Vsce `
        -ArgumentList @('package', '--out', $hf1Vsix) `
        -WorkingDirectory $hf1Root `
        -RedirectStandardOutput $hf1Stdout `
        -RedirectStandardError $hf1Stderr `
        -NoNewWindow `
        -Wait `
        -PassThru

    Get-Content -LiteralPath $hf1Stdout -ErrorAction SilentlyContinue
    Get-Content -LiteralPath $hf1Stderr -ErrorAction SilentlyContinue

    if ($hf1PackageProcess.ExitCode -ne 0) {
        throw "VSIX packaging failed with exit $($hf1PackageProcess.ExitCode)."
    }

    if (-not (Test-Path -LiteralPath $hf1Vsix -PathType Leaf)) {
        throw 'VSIX output was not created.'
    }

    Add-Type -AssemblyName System.IO.Compression.FileSystem

    $hf1Archive = [System.IO.Compression.ZipFile]::OpenRead($hf1Vsix)

    try {
        $hf1Entries = @(
            $hf1Archive.Entries |
                ForEach-Object { $_.FullName.Replace('\', '/') }
        )
    }
    finally {
        $hf1Archive.Dispose()
    }

    $hf1PackageJson = Get-Content `
        -LiteralPath (Join-Path $hf1Root 'package.json') `
        -Raw |
        ConvertFrom-Json

    $hf1Main = ([string]$hf1PackageJson.main) `
        -replace '^[.][/\\]', '' `
        -replace '\\', '/'

    $hf1ExpectedMainEntry = "extension/$hf1Main"

    if ($hf1Entries -notcontains 'extension/package.json') {
        throw 'VSIX does not contain extension/package.json.'
    }

    if ($hf1Entries -notcontains $hf1ExpectedMainEntry) {
        throw "VSIX does not contain its declared main file: $hf1ExpectedMainEntry"
    }

    if (-not ($hf1Entries | Where-Object {
        $_ -like 'extension/resources/copilot/*'
    })) {
        throw 'VSIX does not contain the packaged Copilot resources.'
    }

    $hf1ForbiddenPatterns = @(
        '^extension/\.git/',
        '^extension/\.github/',
        '^extension/\.vscode-test/',
        '^extension/docs/eval/',
        '^extension/src/test/',
        '^extension/out/test/',
        '^extension/(AGENT|AGENTS)\.md$',
        '\.tsbuildinfo',
        '\.log$',
        '\.vsix$'
    )

    $hf1ForbiddenEntries = @(
        foreach ($hf1Entry in $hf1Entries) {
            foreach ($hf1Pattern in $hf1ForbiddenPatterns) {
                if ($hf1Entry -match $hf1Pattern) {
                    $hf1Entry
                    break
                }
            }
        }
    ) | Sort-Object -Unique

    if ($hf1ForbiddenEntries.Count -gt 0) {
        Write-Host ''
        Write-Host 'Forbidden package entries detected:'
        $hf1ForbiddenEntries | ForEach-Object {
            Write-Host "  $_"
        }

        throw 'HF1 test VSIX content check failed. Do not install this package.'
    }

    $hf1AfterStatus = @(
        git status --porcelain=v1 --untracked-files=all
    )

    if (($hf1BeforeStatus -join "`n") -ne ($hf1AfterStatus -join "`n")) {
        throw 'Repository state changed during packaging.'
    }

    $hf1VsixHash = (
        Get-FileHash -LiteralPath $hf1Vsix -Algorithm SHA256
    ).Hash

    Write-Host ''
    Write-Host "VSIX: $hf1Vsix"
    Write-Host "SHA-256: $hf1VsixHash"
    Write-Host "Files inside VSIX: $($hf1Entries.Count)"
    Write-Host 'Repository source state: UNCHANGED'
    Write-Host 'HF1_TEST_VSIX_CREATED_CONTENTS_CHECKED'
}
