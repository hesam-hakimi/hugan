& {
    $ErrorActionPreference = 'Stop'

    $v2Root = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1_v2'
    $npm = 'C:\Program Files\nodejs\npm.cmd'

    Set-Location -LiteralPath $v2Root

    $beforeStatus = @(git status --porcelain=v1 --untracked-files=all)

    $id = [Guid]::NewGuid().ToString('N')
    $stdout = Join-Path $env:TEMP "hf1-v2-full-$id.out.log"
    $stderr = Join-Path $env:TEMP "hf1-v2-full-$id.err.log"

    Write-Host '========== FULL UNIT REGRESSION =========='

    $p = Start-Process `
        -FilePath $npm `
        -ArgumentList @('run','test:unit') `
        -WorkingDirectory $v2Root `
        -RedirectStandardOutput $stdout `
        -RedirectStandardError $stderr `
        -NoNewWindow `
        -Wait `
        -PassThru

    $text = @(
        if (Test-Path $stdout) { Get-Content $stdout -Raw }
        if (Test-Path $stderr) { Get-Content $stderr -Raw }
    ) -join [Environment]::NewLine

    $clean = [regex]::Replace(
        $text,
        '\x1B\[[0-?]*[ -/]*[@-~]',
        ''
    )

    $summaries = [regex]::Matches(
        $clean,
        '(?m)^\s*(\d+)\s+failing\b'
    )

    if ($summaries.Count -eq 0) {
        $failureCount = 0
    }
    else {
        $failureCount = [int]$summaries[
            $summaries.Count - 1
        ].Groups[1].Value
    }

    Write-Host "Process exit: $($p.ExitCode)"
    Write-Host "Failure count: $failureCount"

    $clean -split "`r?`n" |
        Select-String 'passing|pending|failing' |
        Select-Object -Last 10 |
        ForEach-Object { Write-Host $_ }

    # These five historical failures are unrelated to HF1 V2
    $mandatoryBaselineFailures = @(
        'passes against the committed Phase H baseline report',
        'allows deterministic v3 baseline reports without prompt telemetry',
        'maintainer delivery prompt references real repo-local agents',
        'repo customization assets use valid frontmatter and agent file naming',
        'source tree uses standard AGENTS.md guidance instead of module AGENT.md files'
    )

    foreach ($expected in $mandatoryBaselineFailures) {
        if (-not $clean.Contains($expected)) {
            throw "Historical baseline identity missing or changed: $expected"
        }

        Write-Host "BASELINE CONFIRMED: $expected"
    }

    $packageAssetFailure =
        'excludes dev logs, eval outputs, generated packages, and test artifacts from VSIX candidate'

    # 5 failures = package hygiene failure disappeared.
    # 6 failures = same historical package failure still exists.
    if ($failureCount -eq 6) {

        if (-not $clean.Contains($packageAssetFailure)) {
            throw 'Six failures observed, but the sixth is not the known package-asset baseline failure.'
        }

        Write-Host 'PACKAGE-ASSET BASELINE: STILL PRESENT'
    }
    elseif ($failureCount -eq 5) {

        if ($clean.Contains($packageAssetFailure)) {
            throw 'Package-asset failure text exists despite a five-failure total.'
        }

        Write-Host 'PACKAGE-ASSET BASELINE: RESOLVED'
    }
    else {
        $clean -split "`r?`n" | Select-Object -Last 300
        throw "Unexpected regression count: $failureCount"
    }

    $afterStatus = @(git status --porcelain=v1 --untracked-files=all)

    if (
        [string]::Join("`n",$beforeStatus) -cne
        [string]::Join("`n",$afterStatus)
    ) {
        throw 'Repository state changed during full-unit validation.'
    }

    Remove-Item $stdout,$stderr -Force -ErrorAction SilentlyContinue

    Write-Host ''
    Write-Host '=========================================='
    Write-Host 'HF1_V2_FULL_UNIT_REGRESSION_PASS'
    Write-Host '=========================================='
    Write-Host "Known baseline failures: $failureCount"
    Write-Host 'New HF1 V2 regressions: NONE'
    Write-Host 'Repository state changed: NO'
}
