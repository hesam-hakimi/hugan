& {
    $ErrorActionPreference = 'Stop'

    Write-Host "`n========== COMPILE =========="
    npm run compile
    if ($LASTEXITCODE -ne 0) {
        throw "HF1 V2 Repair 2 compile failed."
    }

    Write-Host "`n========== LINT =========="
    npm run lint
    if ($LASTEXITCODE -ne 0) {
        throw "HF1 V2 Repair 2 lint failed."
    }

    Write-Host "`n========== FOCUSED HF1 V2 TESTS =========="
    $env:MOCHA_GREP = 'HF1|Trusted framework|RepoWriter workspace selection|Job development readiness|WriteAuthorization'

    npm run test:unit
    $focusedExit = $LASTEXITCODE

    Remove-Item Env:MOCHA_GREP -ErrorAction SilentlyContinue

    if ($focusedExit -ne 0) {
        throw "HF1 V2 Repair 2 focused tests failed."
    }

    Write-Host ""
    Write-Host "============================================"
    Write-Host "HF1_V2_REPAIR_2_EXTERNAL_VALIDATION_PASS"
    Write-Host "============================================"
}
