
& {
    $ErrorActionPreference = 'Stop'

    $sourceRepo = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension'
    $newClone   = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1_v2'

    $sourceBranch = 'feature/v3-agentic-redesign'
    $hotfixBranch = 'hotfix/hf1-oracle-fresh-consumer-v2'
    $originUrl     = 'https://github.com/TD-Universe/agentic_etl.git'

    if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
        throw 'Git is not available.'
    }

    if (-not (Test-Path -LiteralPath $sourceRepo -PathType Container)) {
        throw "Source repository not found: $sourceRepo"
    }

    if (Test-Path -LiteralPath $newClone) {
        throw "New HF1 clone already exists. Do not delete it: $newClone"
    }

    Write-Host 'Checking committed source branch...'

    $sourceHead = (
        git -C $sourceRepo rev-parse "$sourceBranch"
    ).Trim()

    if ($LASTEXITCODE -ne 0) {
        throw "Unable to resolve $sourceBranch"
    }

    Write-Host "Source branch: $sourceBranch"
    Write-Host "Source HEAD:   $sourceHead"

    $originalWorktreesBefore = @(
        git -C $sourceRepo worktree list --porcelain |
        Select-String '^worktree '
    ).Count

    Write-Host "Original worktree count: $originalWorktreesBefore"

    Write-Host ''
    Write-Host 'Creating isolated clean clone...'

    git clone `
        --local `
        --no-hardlinks `
        --branch $sourceBranch `
        --single-branch `
        -- `
        $sourceRepo `
        $newClone

    if ($LASTEXITCODE -ne 0) {
        throw 'Local clone failed.'
    }

    git -C $newClone remote set-url origin $originUrl

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to set GitHub origin.'
    }

    git -C $newClone switch -c $hotfixBranch $sourceHead

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to create the new HF1 hotfix branch.'
    }

    $cloneStatus = @(
        git -C $newClone status --porcelain=v1 --untracked-files=all
    )

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to verify clone status.'
    }

    if ($cloneStatus.Count -ne 0) {
        throw "New clone is unexpectedly dirty:`n$($cloneStatus -join "`n")"
    }

    $cloneHead = (git -C $newClone rev-parse HEAD).Trim()
    $cloneBranch = (git -C $newClone branch --show-current).Trim()
    $cloneOrigin = (git -C $newClone remote get-url origin).Trim()

    $originalWorktreesAfter = @(
        git -C $sourceRepo worktree list --porcelain |
        Select-String '^worktree '
    ).Count

    if ($originalWorktreesAfter -ne $originalWorktreesBefore) {
        throw 'Original repository worktree inventory changed unexpectedly.'
    }

    Write-Host ''
    Write-Host '========================================'
    Write-Host 'HF1_V2_CLEAN_BRANCH_READY'
    Write-Host '========================================'
    Write-Host "Clone:   $newClone"
    Write-Host "Branch:  $cloneBranch"
    Write-Host "HEAD:    $cloneHead"
    Write-Host "Origin:  $cloneOrigin"
    Write-Host "Status:  CLEAN"
    Write-Host "Original worktrees unchanged: $originalWorktreesAfter"
}
