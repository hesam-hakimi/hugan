& {
    $ErrorActionPreference = 'Stop'

    $hf1Root = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1'
    Set-Location -LiteralPath $hf1Root

    $hf1BeforeStatus = @(git status --porcelain=v1 --untracked-files=all)
    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to capture repository state.'
    }

    $hf1SourceVsix = Get-ChildItem -LiteralPath $env:TEMP `
        -Directory `
        -Filter 'HF1_TEST_PACKAGE_*' |
        ForEach-Object {
            Get-ChildItem -LiteralPath $_.FullName `
                -File `
                -Filter 'databricks-etl-copilot-hf1-test.vsix' `
                -ErrorAction SilentlyContinue
        } |
        Sort-Object LastWriteTimeUtc -Descending |
        Select-Object -First 1

    if ($null -eq $hf1SourceVsix) {
        throw 'The previously generated HF1 test VSIX was not found.'
    }

    $hf1SafeDirectory = Join-Path `
        $env:TEMP `
        ('HF1_TEST_PACKAGE_SANITIZED_' + (Get-Date -Format 'yyyyMMdd_HHmmss'))

    New-Item -ItemType Directory -Path $hf1SafeDirectory |
        Out-Null

    $hf1SafeVsix = Join-Path `
        $hf1SafeDirectory `
        'databricks-etl-copilot-hf1-test-sanitized.vsix'

    Copy-Item `
        -LiteralPath $hf1SourceVsix.FullName `
        -Destination $hf1SafeVsix

    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem

    $hf1Archive = [System.IO.Compression.ZipFile]::Open(
        $hf1SafeVsix,
        [System.IO.Compression.ZipArchiveMode]::Update
    )

    try {
        foreach ($hf1EntryName in @(
            'extension/.tsbuildinfo.test',
            'extension/tsconfig.test.json'
        )) {
            $hf1Entry = $hf1Archive.GetEntry($hf1EntryName)

            if ($null -ne $hf1Entry) {
                Write-Host "REMOVING FROM TEMP VSIX: $hf1EntryName"
                $hf1Entry.Delete()
            }
        }
    }
    finally {
        $hf1Archive.Dispose()
    }

    $hf1Archive = [System.IO.Compression.ZipFile]::OpenRead($hf1SafeVsix)

    try {
        $hf1Entries = @(
            $hf1Archive.Entries |
            ForEach-Object {
                $_.FullName.Replace('\', '/')
            }
        )
    }
    finally {
        $hf1Archive.Dispose()
    }

    foreach ($hf1RequiredEntry in @(
        'extension/package.json',
        'extension/out/extension.js',
        'extension/out/sttm-runtime.js'
    )) {
        if ($hf1Entries -notcontains $hf1RequiredEntry) {
            throw "Required VSIX entry is missing: $hf1RequiredEntry"
        }
    }

    $hf1CopilotResources = @(
        $hf1Entries |
        Where-Object {
            $_ -match '^extension/resources/copilot/.+'
        }
    )

    if ($hf1CopilotResources.Count -eq 0) {
        throw 'Required Copilot resources are missing.'
    }

    $hf1ForbiddenPatterns = @(
        '^extension/(?:\.git|\.github|\.vscode-test)(?:/|$)',
        '^extension/docs/eval(?:/|$)',
        '^extension/src/test(?:/|$)',
        '^extension/out/test(?:/|$)',
        '^extension/(?:.*/)?(?:AGENT|AGENTS)\.md$',
        '^extension/(?:.*/)?[^/]*\.tsbuildinfo(?:\..*)?$',
        '^extension/(?:.*/)?tsconfig\.test\.json$',
        '^extension/.*\.log$',
        '^extension/.*\.vsix$'
    )

    $hf1ForbiddenEntries = @(
        foreach ($hf1Entry in $hf1Entries) {
            foreach ($hf1Pattern in $hf1ForbiddenPatterns) {
                if ($hf1Entry -match $hf1Pattern) {
                    $hf1Entry
                    break
                }
            }
        }
    ) | Sort-Object -Unique

    if ($hf1ForbiddenEntries.Count -ne 0) {
        Write-Host 'Forbidden entries remain:'

        $hf1ForbiddenEntries |
            ForEach-Object {
                Write-Host "  $_"
            }

        throw 'Sanitized HF1 VSIX content check failed. Do not install it.'
    }

    $hf1AfterStatus = @(git status --porcelain=v1 --untracked-files=all)
    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to verify final repository state.'
    }

    if (
        [string]::Join("`n", $hf1BeforeStatus) -cne
        [string]::Join("`n", $hf1AfterStatus)
    ) {
        throw 'Repository state changed while sanitizing the VSIX.'
    }

    $hf1Hash = (
        Get-FileHash `
            -LiteralPath $hf1SafeVsix `
            -Algorithm SHA256
    ).Hash

    Write-Host ''
    Write-Host "SAFE TEST VSIX: $hf1SafeVsix"
    Write-Host "SHA-256: $hf1Hash"
    Write-Host "Files inside VSIX: $($hf1Entries.Count)"
    Write-Host 'Repository source state: UNCHANGED'
    Write-Host 'HF1_TEST_VSIX_SANITIZED_CONTENTS_CHECKED'
}
