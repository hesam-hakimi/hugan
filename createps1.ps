& {
    $ErrorActionPreference = 'Stop'

    $hf1Original = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension'
    $hf1Clone = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1'
    $hf1DependencySource = Join-Path $hf1Original 'node_modules'
    $hf1DependencyDestination = Join-Path $hf1Clone 'node_modules'
    $hf1ExpectedHead = 'b2e44c3a1a051aa7fa6008831d225bc06d22e847'
    $hf1NodeExe = 'C:\Program Files\nodejs\node.exe'
    $hf1NpmCmd = 'C:\Program Files\nodejs\npm.cmd'

    if (-not (Test-Path -LiteralPath $hf1Clone -PathType Container)) {
        throw "HF1 clone does not exist: $hf1Clone"
    }

    if (-not (Test-Path -LiteralPath $hf1DependencySource -PathType Container)) {
        throw "Source node_modules does not exist: $hf1DependencySource"
    }

    if (Test-Path -LiteralPath $hf1DependencyDestination) {
        throw "HF1 node_modules already exists. Stop and inspect it before continuing."
    }

    if (-not (Test-Path -LiteralPath $hf1NodeExe -PathType Leaf)) {
        throw "Node executable was not found: $hf1NodeExe"
    }

    if (-not (Test-Path -LiteralPath $hf1NpmCmd -PathType Leaf)) {
        throw "npm.cmd was not found: $hf1NpmCmd"
    }

    $hf1ObservedHead = (& git -C $hf1Clone rev-parse HEAD).Trim()

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to read the HF1 clone HEAD.'
    }

    if ($hf1ObservedHead -ne $hf1ExpectedHead) {
        throw "Unexpected HF1 HEAD: $hf1ObservedHead"
    }

    $hf1StatusBefore = @(& git -C $hf1Clone status --short --untracked-files=all)

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to read the HF1 clone status.'
    }

    if ($hf1StatusBefore.Count -ne 0) {
        throw "HF1 clone is not clean before dependency preparation:`n$($hf1StatusBefore -join "`n")"
    }

    Write-Host 'Copying existing local dependencies into the isolated HF1 clone...'

    & robocopy.exe `
        $hf1DependencySource `
        $hf1DependencyDestination `
        /E /COPY:DAT /DCOPY:DAT /R:1 /W:1 /XJ /NFL /NDL /NJH /NJS /NP

    $hf1CopyExit = $LASTEXITCODE

    if ($hf1CopyExit -ge 8) {
        throw "Dependency copy failed with robocopy exit code $hf1CopyExit"
    }

    Set-Location -LiteralPath $hf1Clone

    & $hf1NodeExe --version
    if ($LASTEXITCODE -ne 0) {
        throw 'Node execution failed.'
    }

    & $hf1NpmCmd --version
    if ($LASTEXITCODE -ne 0) {
        throw 'npm execution failed.'
    }

    & $hf1NpmCmd ls --depth=0
    if ($LASTEXITCODE -ne 0) {
        throw 'Copied dependencies do not match the clean HF1 package.json.'
    }

    & $hf1NpmCmd run compile
    if ($LASTEXITCODE -ne 0) {
        throw 'Baseline compile failed.'
    }

    & $hf1NpmCmd run lint
    if ($LASTEXITCODE -ne 0) {
        throw 'Baseline lint failed.'
    }

    & $hf1NpmCmd run test:unit
    if ($LASTEXITCODE -ne 0) {
        throw 'Baseline unit tests failed.'
    }

    $hf1StatusAfter = @(& git status --short --untracked-files=all)

    if ($LASTEXITCODE -ne 0) {
        throw 'Unable to read final Git status.'
    }

    if ($hf1StatusAfter.Count -ne 0) {
        throw "Source drift detected after toolchain preparation:`n$($hf1StatusAfter -join "`n")"
    }

    Write-Host ''
    Write-Host 'HF1_BASELINE_TOOLCHAIN_READY'
    Write-Host "HEAD: $hf1ObservedHead"
    Write-Host 'Git status: CLEAN'
    Write-Host 'Network/download/install: NONE'
}
