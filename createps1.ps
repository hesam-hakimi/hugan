& {
    $ErrorActionPreference = 'Stop'

    $hf1Root = 'C:\repos\etl-extension\etl_fw2\etl_framework_extension_hf1'
    $hf1Npm  = 'C:\Program Files\nodejs\npm.cmd'

    Set-Location -LiteralPath $hf1Root

    $hf1Id = [Guid]::NewGuid().ToString('N')
    $hf1Stdout = Join-Path $env:TEMP "hf1-unit-$hf1Id.out.log"
    $hf1Stderr = Join-Path $env:TEMP "hf1-unit-$hf1Id.err.log"

    $hf1Process = Start-Process `
        -FilePath $hf1Npm `
        -ArgumentList @('run', 'test:unit') `
        -WorkingDirectory $hf1Root `
        -RedirectStandardOutput $hf1Stdout `
        -RedirectStandardError $hf1Stderr `
        -NoNewWindow `
        -Wait `
        -PassThru

    $hf1Text = @(
        if (Test-Path -LiteralPath $hf1Stdout) {
            Get-Content -LiteralPath $hf1Stdout -Raw
        }
        if (Test-Path -LiteralPath $hf1Stderr) {
            Get-Content -LiteralPath $hf1Stderr -Raw
        }
    ) -join [Environment]::NewLine

    $hf1Clean = [regex]::Replace(
        $hf1Text,
        '\x1B\[[0-?]*[ -/]*[@-~]',
        ''
    )

    $hf1ExpectedFailures = @(
        'passes against the committed Phase H baseline report',
        'allows deterministic v3 baseline reports without prompt telemetry',
        'excludes dev logs, eval outputs, generated packages, and test artifacts from VSIX candidate',
        'maintainer delivery prompt references real repo-local agents',
        'repo customization assets use valid frontmatter and agent file naming',
        'source tree uses standard AGENTS.md guidance instead of module AGENT.md files'
    )

    $hf1Summaries = [regex]::Matches(
        $hf1Clean,
        '(?m)^\s*(\d+)\s+failing\b'
    )

    if ($hf1Summaries.Count -eq 0) {
        $hf1Clean -split "`r?`n" | Select-Object -Last 250
        throw 'Could not locate the Mocha failing-count summary.'
    }

    $hf1FailureCount = [int]$hf1Summaries[
        $hf1Summaries.Count - 1
    ].Groups[1].Value

    Write-Host "Full-unit process exit: $($hf1Process.ExitCode)"
    Write-Host "Mocha failure count: $hf1FailureCount"

    if ($hf1FailureCount -ne 6) {
        $hf1Clean -split "`r?`n" | Select-Object -Last 250
        throw "Expected exactly 6 baseline failures; observed $hf1FailureCount."
    }

    foreach ($hf1Expected in $hf1ExpectedFailures) {
        if (-not $hf1Clean.Contains($hf1Expected)) {
            $hf1Clean -split "`r?`n" | Select-Object -Last 250
            throw "Expected baseline failure missing: $hf1Expected"
        }

        Write-Host "CONFIRMED: $hf1Expected"
    }

    Remove-Item -LiteralPath $hf1Stdout, $hf1Stderr -Force

    Write-Host ''
    Write-Host 'HF1_EXTERNAL_VALIDATION_PASS'
}
