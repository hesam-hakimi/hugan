$ErrorActionPreference = 'Stop'

$repo = 'C:\repos\etl-extension\etl_fw2\recovery-extension-product-0.3.147'
$cmd = 'C:\Windows\System32\cmd.exe'
$git = (Get-Command git.exe -CommandType Application -ErrorAction Stop).Source
$node = (Get-Command node.exe -CommandType Application -ErrorAction Stop).Source
$probe = Join-Path $env:TEMP "etl-native-probe-$([guid]::NewGuid().ToString('N')).txt"

$expectedStatus = @(
    ' M .github/templates/request.md'
    ' M src/test/runTest.ts'
    '?? src/test/suite/sttmRealHostStructuredResult.test.ts'
)

try {
    $LASTEXITCODE = $null
    & $cmd /d /c ("echo NATIVE_CMD_OK>{0}" -f $probe)
    $cmdExit = $LASTEXITCODE
    $cmdResult = if (Test-Path -LiteralPath $probe) {
        (Get-Content -LiteralPath $probe -Raw).Trim()
    } else {
        'FILE_MISSING'
    }

    $LASTEXITCODE = $null
    $gitOutput = @(& $git --version 2>&1)
    $gitExit = $LASTEXITCODE

    $LASTEXITCODE = $null
    $nodeOutput = @(& $node --version 2>&1)
    $nodeExit = $LASTEXITCODE

    $LASTEXITCODE = $null
    $status = @(& $git -C $repo status --porcelain=v1 --untracked-files=all 2>&1)
    $statusExit = $LASTEXITCODE

    $statusExact = (($status -join "`n") -ceq ($expectedStatus -join "`n"))

    [pscustomobject]@{
        CmdResult                   = $cmdResult
        CmdExit                     = $cmdExit
        GitPath                     = $git
        GitVersion                  = ($gitOutput -join ' ')
        GitExit                     = $gitExit
        NodePath                    = $node
        NodeVersion                 = ($nodeOutput -join ' ')
        NodeExit                    = $nodeExit
        GitStatusExit               = $statusExit
        GitStatusExact              = $statusExact
        ElectronRunAsNodePresent    = [bool](
            Get-ChildItem Env: |
            Where-Object { $_.Name -ieq 'ELECTRON_RUN_AS_NODE' }
        )
    } | Format-List

    $status | ForEach-Object { "STATUS: $_" }

    if (
        $cmdResult -eq 'NATIVE_CMD_OK' -and
        $cmdExit -eq 0 -and
        $gitExit -eq 0 -and
        $nodeExit -eq 0 -and
        $statusExit -eq 0 -and
        $statusExact
    ) {
        Write-Host 'F5_NATIVE_TERMINAL_PASS' -ForegroundColor Green
    } else {
        Write-Host 'F5_NATIVE_TERMINAL_BLOCKED' -ForegroundColor Red
    }
}
finally {
    Remove-Item -LiteralPath $probe -Force -ErrorAction SilentlyContinue
}
